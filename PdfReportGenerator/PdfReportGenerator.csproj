<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfReportGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <!--
    seed-data/books.json is the INPUT to the seed script, not a build artifact.
    The app reads it from the working directory (dotnet run starts in the
    project folder), so it does not need copying to bin/ - but listing it
    here keeps it visible in the IDE and out of the compile glob.
  -->
  <ItemGroup>
    <None Include="seed-data\books.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
